// PricePulse Database Schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  // Runtime queries go through the TRANSACTION pooler (port 6543). Supabase's
  // session pooler allows only 15 clients in total, and Prisma opens its own
  // pool per instance, so the app hit "max clients reached in session mode"
  // on ordinary page loads.
  url       = env("DATABASE_URL")
  // Migrations cannot run over the transaction pooler, so they use the
  // session pooler (port 5432) directly.
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  resetToken       String?     @unique  // hashed password-reset token
  resetTokenExpiry DateTime?            // when the reset token expires
  tokenVersion  Int            @default(0) // bumped on password change/reset to invalidate old JWTs
  emailAlertsEnabled Boolean   @default(true) // whether price-drop alerts are sent by email (in-app notifications always fire regardless)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wishlistItems WishlistItem[]
  notifications Notification[]
}

model Product {
  id            Int            @id @default(autoincrement())
  title         String
  url           String?
  imageUrl      String?
  currentPrice  Float
  lowestPrice   Float
  highestPrice  Float
  currency      String         @default("USD")
  source        String
  serpApiQuery  String
  // Google Shopping market the query was run in (SerpApi/Serper `gl`). The
  // price history of a product is only meaningful within one market, so the
  // scheduler re-queries with the same country the listing was found in.
  country       String         @default("us")
  lastChecked   DateTime       @default(now())
  // Adaptive schedule (see services/scheduling.js). The sweep runs hourly and
  // only re-checks products whose nextCheckAt has passed; the interval is
  // recomputed after every observation from how volatile the price is and
  // how many people are tracking it.
  checkIntervalHours Int       @default(6)
  nextCheckAt   DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  wishlistItems WishlistItem[]
  priceHistory  PriceHistory[]
  notifications Notification[]

  @@index([nextCheckAt])
}

model WishlistItem {
  id                Int      @id @default(autoincrement())
  userId            Int
  productId         Int
  targetPrice       Float?
  targetDropPercent Float?   // notify when price drops X% from highest
  notified          Boolean  @default(false) // a drop alert has been sent for the current move
  // Tracked separately from `notified` so a generic "dropped 3%" alert can
  // never suppress the "hit your target" alert that follows it. Cleared when
  // the price recovers, which re-arms both.
  notifiedTargetAt  DateTime?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  productId  Int
  price      Float
  recordedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // 'price_drop' or 'target_hit'
  message   String
  productId Int?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
}

