# Database
# Local dev (docker-compose): the value below works as-is.
# Production: use the connection string from your Supabase project's
# Settings -> Database page (the "Direct connection" string, not the pooler).
DATABASE_URL="postgresql://postgres:password@localhost:5432/pricepulse"

# JWT
JWT_SECRET="replace_with_a_long_random_secret"

# SerpApi
# Live product search provider: serpapi (default) | brightdata | serper
SEARCH_PROVIDER=serpapi

# SerpApi — 250 searches/month free, renewed monthly. Sign up at serpapi.com
# and copy the private API key from the dashboard.
SERPAPI_KEY="your_serpapi_key_here"
# Optional locale for shopping results (defaults: us / en)
SERPAPI_COUNTRY=us
SERPAPI_LANGUAGE=en

# Bright Data SERP API — 5,000 requests/month free, renewed monthly.
# Create a SERP zone in the Bright Data control panel: the zone NAME goes in
# BRIGHTDATA_SERP_ZONE, the account API token in BRIGHTDATA_API_KEY.
BRIGHTDATA_API_KEY="your_brightdata_api_token_here"
BRIGHTDATA_SERP_ZONE="your_serp_zone_name_here"

# How long a search result is reused before spending another request (ms).
SEARCH_CACHE_TTL_MS=21600000

# Serper.dev — legacy provider, free tier is a one-time 2,500 credits.
# Only used when SEARCH_PROVIDER=serper.
SERP_API_KEY="your_serper_key_here"

# Resend (resend.com)
RESEND_API_KEY="your_resend_api_key_here"

# App
PORT=5000
CLIENT_URL="http://localhost:3000"

# Shared secret proving a request came through the Cloudflare Pages Function
# proxy (frontend/functions/api/[[path]].js), not a direct hit on this
# backend's public URL. Must match the INTERNAL_PROXY_SECRET set on the
# Cloudflare Pages project. Used only to decide whether the 'cf-connecting-ip'
# header can be trusted for rate limiting; leave unset for local dev.
INTERNAL_PROXY_SECRET=""

# Cron schedule (default: every 6 hours)
CRON_SCHEDULE="0 */6 * * *"

# Web Push (optional: enables browser push notifications)
# Generate a key pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@pricepulse.app"
