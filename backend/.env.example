# Database
# Local dev (docker-compose): the value below works as-is.
# Production: use the connection string from your Supabase project's
# Settings -> Database page (the "Direct connection" string, not the pooler).
DATABASE_URL="postgresql://postgres:password@localhost:5432/pricepulse"

# JWT
JWT_SECRET="replace_with_a_long_random_secret"

# SerpApi — 250 searches/month free, renewed monthly. Sign up at serpapi.com
# and copy the private API key from the dashboard.
SERPAPI_KEY="your_serpapi_key_here"
# Default shopping market for searches that do not pick one (the search page
# lets each visitor choose a country; see backend/src/services/markets.js).
SERPAPI_COUNTRY=us

# How long a search result is reused before spending another request (ms).
SEARCH_CACHE_TTL_MS=21600000
# Listings requested per search (max 100). One request returns up to 100
# whatever this is, so a bigger page costs no extra quota — it just gives the
# tech/price/carrier filters more to work with.
RESULTS_PER_SEARCH=60

# Resend (resend.com)
RESEND_API_KEY="your_resend_api_key_here"

# App
PORT=5000
CLIENT_URL="http://localhost:3000"

# Shared secret proving a request came through the Cloudflare Pages Function
# proxy (frontend/functions/api/[[path]].js), not a direct hit on this
# backend's public URL. Must match the INTERNAL_PROXY_SECRET set on the
# Cloudflare Pages project. Used only to decide whether the 'cf-connecting-ip'
# header can be trusted for rate limiting; leave unset for local dev.
INTERNAL_PROXY_SECRET=""

# How often the price sweep TICKS (default: hourly). Which products are
# actually re-checked on a tick is decided per product: every 3 to 48 hours
# depending on trackers, volatility and how close a target is
# (backend/src/services/scheduling.js).
CRON_SCHEDULE="0 * * * *"
# Bounds for the adaptive interval, in hours.
SCHEDULE_MIN_HOURS=3
SCHEDULE_MAX_HOURS=48
# Opening a product page re-checks its price in the background when the last
# check is older than this (ms). 0 disables it.
VIEW_REFRESH_STALE_MS=43200000

