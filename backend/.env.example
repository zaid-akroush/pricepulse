# Database
# Local dev (docker-compose): the value below works as-is.
# Production: use the connection string from your Supabase project's
# Settings -> Database page (the "Direct connection" string, not the pooler).
DATABASE_URL="postgresql://postgres:password@localhost:5432/pricepulse"

# JWT
JWT_SECRET="replace_with_a_long_random_secret"

# SerpApi
SERP_API_KEY="your_serpapi_key_here"

# Resend (resend.com)
RESEND_API_KEY="your_resend_api_key_here"

# App
PORT=5000
CLIENT_URL="http://localhost:3000"

# Shared secret proving a request came through the Cloudflare Pages Function
# proxy (frontend/functions/api/[[path]].js), not a direct hit on this
# backend's public URL. Must match the INTERNAL_PROXY_SECRET set on the
# Cloudflare Pages project. Used only to decide whether the 'cf-connecting-ip'
# header can be trusted for rate limiting; leave unset for local dev.
INTERNAL_PROXY_SECRET=""

# Cron schedule (default: every 6 hours)
CRON_SCHEDULE="0 */6 * * *"

# Web Push (optional: enables browser push notifications)
# Generate a key pair with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:alerts@pricepulse.app"
